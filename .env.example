# Brand (placeholder until the final name/domain is chosen)
NEXT_PUBLIC_BRAND_NAME=BillboardRank
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database file (SQLite for the MVP; see README for the Postgres migration path)
DATABASE_PATH=./data/app.db

# Secret used to hash visitor IPs for click de-duplication. CHANGE IN PRODUCTION.
HASH_SECRET=change-me

# Payments: "stripe" or "mock" (test mode, no real money)
PAYMENT_PROVIDER=mock
# Stripe: use sk_test_ keys first. Webhook endpoint: /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mock checkout is blocked in production unless this is 1
ALLOW_MOCK_PAYMENTS=1
# HMAC secret for POST /api/webhooks/payments
PAYMENT_WEBHOOK_SECRET=change-me

# Admin dashboard (/admin): sign in with Google. Create an OAuth client at console.cloud.google.com
# (redirect URI: https://billboardrank.com/api/auth/google/callback). Only ADMIN_EMAILS may sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=19101989karan@gmail.com,codebluepulse@gmail.com,nzaucklandkaran@gmail.com
# Secret that signs the admin login cookie. CHANGE IN PRODUCTION.
SESSION_SECRET=change-me
# Search Console property: "sc-domain:billboardrank.com" (domain property) or "https://billboardrank.com/"
GSC_SITE=sc-domain:billboardrank.com

# Email (optional). Without RESEND_API_KEY emails are only recorded in the outbox shown on /admin.
RESEND_API_KEY=
EMAIL_FROM=BillboardRank <hello@billboardrank.com>
# Receives a notice for every payment
ADMIN_EMAIL=
# Secret for the weekly digest endpoint: POST /api/cron/digest with header x-cron-key
CRON_KEY=change-me
