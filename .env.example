# Brand (placeholder until the final name/domain is chosen)
NEXT_PUBLIC_BRAND_NAME=BillboardRank
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database file (SQLite for the MVP; see README for the Postgres migration path)
DATABASE_PATH=./data/app.db

# Secret used to hash visitor IPs for click de-duplication. CHANGE IN PRODUCTION.
HASH_SECRET=change-me

# Payments: "mock" (test mode, no real money) until a provider is wired in
PAYMENT_PROVIDER=mock
# Mock checkout is blocked in production unless this is 1
ALLOW_MOCK_PAYMENTS=1
# HMAC secret for POST /api/webhooks/payments
PAYMENT_WEBHOOK_SECRET=change-me

# Enables /admin?key=... when set
ADMIN_KEY=

# Email (optional). Without RESEND_API_KEY emails are only recorded in the outbox shown on /admin.
RESEND_API_KEY=
EMAIL_FROM=BillboardRank <hello@billboardrank.com>
# Receives a notice for every payment
ADMIN_EMAIL=
# Secret for the weekly digest endpoint: POST /api/cron/digest with header x-cron-key
CRON_KEY=change-me
